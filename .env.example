# abusecode.router — environment (copy to .env or export)

HOST=0.0.0.0
PORT=8000

# SQLite location
ABUSECODE_DB=data/abusecode.db

# Upstream inference API
OPENCODE_API_BASE=https://opencode.ai/inference
OPENCODE_SESSION=
OPENCODE_USER_AGENT=opencode/1.18.35 ai-sdk/provider-utils/4.0.40 runtime/bun/1.3.14

# Dashboard auth (leave empty to disable). When set, /login is required.
ABUSECODE_ADMIN_TOKEN=
# Signs the session cookie (auto-generated if empty)
ABUSECODE_SECRET=
ABUSECODE_SESSION_MAX_AGE=43200

# Proxy auth (leave empty to allow anonymous proxy access)
ABUSECODE_PROXY_TOKEN=
